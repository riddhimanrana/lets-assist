{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "development": true,
      "main": false
    }
  },
  "ignoreCommand": "node scripts/vercel-build-policy.mjs",
  "crons": [
    {
      "path": "/api/cron/csf-communications-dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/csf-class-workbook-refresh",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/csf-import-commit",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/csf-publication-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/project-feedback-followups",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/data-exports",
      "schedule": "*/20 * * * *"
    },
    {
      "path": "/api/cron/paper-signup-notifications",
      "schedule": "3,13,23,33,43,53 * * * *"
    },
    {
      "path": "/api/cron/project-cancellations",
      "schedule": "5,35 * * * *"
    },
    {
      "path": "/api/cron/organization-calendar-sync",
      "schedule": "12 * * * *"
    },
    {
      "path": "/api/cron/organization-sheet-sync",
      "schedule": "27 */2 * * *"
    },
    {
      "path": "/api/cron/auto-publish-hours",
      "schedule": "10 3,15 * * *"
    },
    {
      "path": "/api/cron/generate-recurring-projects",
      "schedule": "10 1,13 * * *"
    },
    {
      "path": "/api/cron/waiver-cleanup",
      "schedule": "25 */12 * * *"
    },
    {
      "path": "/api/cron/ai-moderation",
      "schedule": "0 0 * * *"
    }
  ]
}

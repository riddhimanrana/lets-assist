{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "lets-assist": {
      "packageName": "lets-assist",
      "development": {
        "local": 3000,
        "fallback": "lets-assist.com"
      }
    },
    "lets-assist-csf": {
      "packageName": "@lets-assist/dvhs-csf-app",
      "routing": [
        {
          "group": "dvhs-csf-application",
          "flag": "dvhs-csf-application-runtime",
          "paths": [
            "/organization/:organizationId/plugins/dvhs-csf/access-proof"
          ]
        }
      ],
      "development": {
        "local": 3001
      }
    }
  },
  "options": {
    "localProxyPort": 3024,
    "disableOverrides": false
  }
}

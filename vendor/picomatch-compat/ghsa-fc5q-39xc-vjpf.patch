+// Let's Assist repair for GHSA-fc5q-39xc-vjpf. A single-branch `+(...)` or
+// `*(...)` whose branch contains a wildcard nests that wildcard's unbounded
+// quantifier inside the outer repeat, which backtracks catastrophically.
+const hasUnescapedWildcard = branch => {
+  let escaped = false;
+

{
  "version": 3,
  "routes": [
    {
      "src": "^/api(?:/.*)?$",
      "dest": "/maintenance-api.json",
      "status": 503,
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "Content-Type": "application/json; charset=utf-8",
        "Retry-After": "300",
        "X-Lets-Assist-Maintenance": "schema-cutover"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/maintenance.html",
      "status": 503,
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "Retry-After": "300",
        "X-Lets-Assist-Maintenance": "schema-cutover",
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ],
  "crons": []
}
